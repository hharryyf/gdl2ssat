front(mark(1,1)). back(noop).
actord(mark(1,1), mark(1,2)).
actord(mark(1,2), mark(1,3)).
actord(mark(1,3), mark(1,4)).
actord(mark(1,4), mark(2,1)).
actord(mark(2,1), mark(2,2)).
actord(mark(2,2), mark(2,3)).
actord(mark(2,3), mark(2,4)).
actord(mark(2,4), mark(3,1)).
actord(mark(3,1), mark(3,2)).
actord(mark(3,2), mark(3,3)).
actord(mark(3,3), mark(3,4)).
actord(mark(3,4), mark(4,1)).
actord(mark(4,1), mark(4,2)).
actord(mark(4,2), mark(4,3)).
actord(mark(4,3), mark(4,4)).
actord(mark(4,4), noop).

ordom(1..1,1).
ordom(1..15,2).
ordom(1..1,3).
ordom(1..13,4).
ordom(1..1,5).
ordom(1..17,6).
ordom(1..1,7).
ordom(1..17,8).
ordom(1..1,9).
ordom(1..17,10).
ordom(1..1,11).
ordom(1..17,12).
ordom(1..1,13).
ordom(1..17,14).
ordom(1..1,15).
ordom(1..17,16).
legal_id(A, 0, T) :- front(A), not legal(oplayer, A, T), mtdom(T).
legal_id(A, 1, T) :- front(A), legal(oplayer, A, T), mtdom(T).
legal_id(B, N, T) :- actord(A, B), legal(oplayer, B, T), legal_id(A, N-1, T), ordom(N, T).
legal_id(B, N, T) :- actord(A, B), not legal(oplayer, B, T), legal_id(A, N, T).
tol_act(N, T) :- legal_id(A, N, T), back(A).

{moveR(oplayer, I, T)} :- ordom(I, T), I > 1.
