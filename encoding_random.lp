% Basic quantifiers
_chance(T * 2, 1, I, moveL(xplayer, I, T)) :- mtdom(T), ordom(I), I > 1.
_exists(T * 2 - 1, does(oplayer, A, T)) :- mtdom(T), input(oplayer, A).
